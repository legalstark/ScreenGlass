<Window x:Class="ScreenGlass.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:visuals="clr-namespace:ScreenGlass.Controls" Title="ScreenGlass" Width="960" Height="714" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize" Background="Transparent" FontFamily="Segoe UI, Microsoft YaHei UI" Loaded="OnLoaded" UseLayoutRounding="True">
 <Border CornerRadius="8" BorderBrush="#B8FFFFFF" BorderThickness="1" Background="{DynamicResource GlassSurface}">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource GlassCard}" CornerRadius="20,0,0,20" BorderBrush="#70FFFFFF" BorderThickness="0,0,1,0">
    <Grid Margin="20,26,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><Border Width="38" Height="38" CornerRadius="12" Background="#65FFFFFF" HorizontalAlignment="Left" BorderBrush="#DCE6DA" BorderThickness="1"><TextBlock Text="◒" FontSize="28" Foreground="{DynamicResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/></Border><TextBlock Text="ScreenGlass" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="珠宝太阳镜 · 为光着色" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
     <StackPanel Grid.Row="1" Margin="-6,40,-6,0"><Button Background="#70FFFFFF" HorizontalContentAlignment="Left" Click="HomeClick"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="{DynamicResource Green}" Margin="0,0,14,0"/><TextBlock Text="柔光控制" FontWeight="SemiBold"/></StackPanel></Button><Button Margin="0,8,0,0" Click="SettingsClick"><StackPanel Orientation="Horizontal"><TextBlock Text="☷" Foreground="{DynamicResource Muted}" Margin="0,0,14,0"/><TextBlock Text="偏好设置" Foreground="{DynamicResource Muted}"/></StackPanel></Button></StackPanel>
     <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="2,0,0,36"><Grid Width="130" Height="130"><Ellipse Margin="5"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentHaloColor}"/><GradientStop Color="#00DDE8D9" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse><Ellipse Width="73" Height="73" Stroke="{DynamicResource SelectedStroke}" StrokeThickness="1"/><Ellipse Width="100" Height="100" Stroke="{DynamicResource SelectedStroke}" StrokeThickness="0.6"/><Ellipse Width="49" Height="49" Fill="{DynamicResource Green}" Opacity="0.25"/><TextBlock Text="✧" FontSize="29" Foreground="{DynamicResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="少一点刺眼" FontSize="13" Margin="0,15,0,5"/><TextBlock Text="多一点专注与舒适" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
     <TextBlock x:Name="VersionCaption" Grid.Row="3" FontSize="7" Foreground="{DynamicResource Muted}"/>
    </Grid>
   </Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="L’ATELIER DE LUMIÈRE    /    光的工作室" FontSize="10" Foreground="{DynamicResource Muted}" Margin="30,19,0,0"/><StackPanel xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" shell:WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,12,0"><Button Content="快捷面板 ↗" FontSize="10" Padding="10,0" Margin="0,7,8,7" Click="QuickClick"/><Button Content="−" Width="32" Padding="0" Click="MinimizeClick" ToolTip="收起到托盘"/><Button Content="×" Width="32" Padding="0" Click="CloseClick" ToolTip="关闭面板，后台运行"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="30,10,30,22">
     <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,21"><StackPanel><TextBlock Text="给屏幕，戴上珠宝太阳镜。" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="从深色编辑器到白色网页，舒适无需来回调节。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#70FFFFFF" CornerRadius="12" Padding="10,6" Margin="0,6,0,0"><TextBlock Text="●  本地运行" Foreground="{DynamicResource Green}" FontSize="9"/></Border></Grid>
      <Border Grid.Row="1" CornerRadius="16" BorderBrush="#A0FFFFFF" BorderThickness="1" Padding="24,22" MinHeight="164" Background="{DynamicResource GlassCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="J E W E L   /   S U N   L E N S E S" Foreground="{DynamicResource Muted}" FontSize="9"/><TextBlock x:Name="StatusTitle" Text="柔光，已就绪" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,7"/><TextBlock x:Name="StatusDescription" Text="开启后，为明亮页面轻轻降一档。" Foreground="{DynamicResource Muted}" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><ToggleButton x:Name="PowerToggle" Click="PowerClick" AutomationProperties.Name="开启柔光"/><TextBlock x:Name="PowerLabel" Text="点击开启" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></StackPanel><Button Grid.Column="1" Style="{StaticResource LensButton}" Click="PowerClick" PreviewMouseWheel="LensWheel" ToolTip="点击镜片开关柔光；滚轮调整强度，Shift 加速" AutomationProperties.Name="珠宝太阳镜柔光开关"><visuals:JewelSunglasses SkinId="{DynamicResource ActiveSkinId}" Width="176" Height="118" Strength="{Binding Value, ElementName=StrengthSlider}" IsLightEnabled="{Binding IsChecked, ElementName=PowerToggle}"/></Button></Grid></Border>
      <Border Grid.Row="2" Background="{DynamicResource GlassCard}" BorderBrush="#90FFFFFF" BorderThickness="1" CornerRadius="14" Padding="21,17" Margin="0,15,0,0"><StackPanel><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="柔光强度" FontSize="12" FontWeight="SemiBold"/><Border Background="#EFF3EB" CornerRadius="4" Padding="6,2" Margin="9,-1,0,0"><TextBlock Text="上限" FontSize="8" Foreground="{DynamicResource Muted}"/></Border></StackPanel><TextBlock x:Name="StrengthLabel" Text="28%" HorizontalAlignment="Right" FontSize="20" FontWeight="SemiBold" Margin="0,-5,0,0"/></Grid><Slider x:Name="StrengthSlider" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="5" PreviewMouseWheel="LensWheel" Minimum="5" Maximum="60" Value="28" ValueChanged="StrengthChanged" Margin="0,10,0,3" AutomationProperties.Name="柔光强度"/><Grid><TextBlock Text="轻柔通透" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock Text="深度柔光" HorizontalAlignment="Right" FontSize="9" Foreground="{DynamicResource Muted}"/></Grid></StackPanel></Border>
      <Grid Grid.Row="3" Margin="0,17,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="找到你的舒适区" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="一键切换场景" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></Grid><UniformGrid Grid.Row="1" Columns="3" Margin="0,11,0,0"><Button x:Name="DailyButton" Click="PresetClick" Tag="daily" Background="#5587BAA2" Margin="0,0,8,0" Padding="10,13"><StackPanel><TextBlock Text="☼   日常舒适" FontSize="11"/><TextBlock Text="轻盈柔和 · 保留通透" FontSize="8" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></Button><Button x:Name="ReadButton" Click="PresetClick" Tag="read" Background="{DynamicResource GlassCard}" Margin="0,0,8,0" Padding="10,13"><StackPanel><TextBlock Text="▤   沉浸阅读" FontSize="11"/><TextBlock Text="柔化白底 · 专注文字" FontSize="8" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></Button><Button x:Name="NightButton" Click="PresetClick" Tag="night" Background="{DynamicResource GlassCard}" Padding="10,13"><StackPanel><TextBlock Text="☾   深夜陪伴" FontSize="11"/><TextBlock Text="更强柔光 · 暖色可独立开启" FontSize="8" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></Button></UniformGrid></Grid>
      <StackPanel Grid.Row="4" Margin="0,22,0,0">
       <visuals:DisplayPanel x:Name="DisplayControls" Margin="0,0,0,16"/>
       <Grid><StackPanel><TextBlock Text="智能跟随页面" FontSize="11"/><TextBlock x:Name="AdaptiveDescription" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><ToggleButton x:Name="AutoToggle" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AutoClick" AutomationProperties.Name="智能跟随页面" ToolTip="Ctrl + Alt + A"/></Grid>
       <Border Height="1" Background="#E3E9DF" Margin="0,12,0,12"/>
       <Grid><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="低敏模式" FontSize="11"/><Button Content="调整触发亮度 ›" FontSize="9" Padding="8,0" Foreground="{DynamicResource Green}" Click="SettingsClick"/></StackPanel><TextBlock x:Name="LowDescription" Text="减少页面变化引起的反复调节" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><ToggleButton x:Name="LowToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="LowClick" AutomationProperties.Name="低敏模式" ToolTip="开启智能跟随时生效"/></Grid>
      </StackPanel>
     </Grid></ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
      <TextBlock Text="按照你的习惯。" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="简单设置，安静陪伴。" Margin="0,10,0,22" Foreground="{DynamicResource Muted}" FontSize="12"/>
      <Border Background="{DynamicResource GlassCard}" CornerRadius="14" Padding="20"><StackPanel>
       <Grid><TextBlock Text="低敏模式 · 触发亮度" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="ThresholdLabel" Text="65%" FontSize="18" HorizontalAlignment="Right"/></Grid>
       <Slider x:Name="ThresholdSlider" Minimum="30" Maximum="90" Value="65" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ThresholdChanged" Margin="0,14,0,5" AutomationProperties.Name="低敏触发亮度"/>
       <Grid><TextBlock Text="较早柔光" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock Text="只在很亮时柔光" HorizontalAlignment="Right" FontSize="9" Foreground="{DynamicResource Muted}"/></Grid>
       <TextBlock Text="屏幕平均亮度连续两次超过触发线，才开启主页设定强度的柔光。&#10;暗下来后恢复原亮度；触发线下方 4% 为缓冲区，避免来回跳动。" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="0,12,0,0"/>
       <TextBlock Text="亮度百分比为本机采样的相对值；低敏模式需配合智能跟随开启。" FontSize="9" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <Border Background="{DynamicResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="珠宝典藏" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="皮肤只改变界面材质，不改变柔光算法。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,12"/><UniformGrid Columns="4"><Button x:Name="JadeSkin" Tag="jade" Click="SkinClick" Padding="4,10" Margin="0,0,6,0"><StackPanel><Ellipse Fill="#328F73" Width="18" Height="18"/><TextBlock Text="翡翠" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="SapphireSkin" Tag="sapphire" Click="SkinClick" Padding="4,10" Margin="0,0,6,0"><StackPanel><Ellipse Fill="#427AA8" Width="18" Height="18"/><TextBlock Text="蓝宝石" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="RoseSkin" Tag="rose" Click="SkinClick" Padding="4,10" Margin="0,0,6,0"><StackPanel><Ellipse Fill="#B9688B" Width="18" Height="18"/><TextBlock Text="玫瑰碧玺" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></Button><Button x:Name="AmberSkin" Tag="amber" Click="SkinClick" Padding="4,10"><StackPanel><Ellipse Fill="#B88843" Width="18" Height="18"/><TextBlock Text="香槟琥珀" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></Button></UniformGrid></StackPanel></Border>
      <Border Background="{DynamicResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,14,0,0"><StackPanel>
       <Grid><StackPanel><TextBlock Text="轻音效" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="开关和场景的轻触反馈；滑块松手时才播放。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,55,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="SoundToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SoundClick" AutomationProperties.Name="交互音效"/></Grid>
       <Button x:Name="PreviewSoundButton" Content="♫  试听音效" Click="PreviewSoundClick" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,7"/>
       <TextBlock x:Name="SoundFeedback" Text="点击试听确认音量；试听不改变静音开关。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Background="{DynamicResource GlassCard}" CornerRadius="14" Padding="20" Margin="0,14,0,0"><StackPanel>
       <TextBlock Text="快捷操作" FontSize="14" FontWeight="SemiBold"/>
       <TextBlock Text="点击输入框后按组合键，自动保存并立即生效。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,7,0,14" TextWrapping="Wrap"/>
       <TextBlock Text="开启 / 暂停柔光" FontSize="12"/>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PowerShortcutBox" Tag="power" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" Padding="12,9" FontSize="13" Background="{DynamicResource GlassCard}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource SelectedStroke}" GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur" PreviewKeyDown="ShortcutKey" AutomationProperties.Name="柔光开关快捷键"/>
        <Button Grid.Column="1" Content="恢复默认" Tag="power" Click="ResetShortcut" Padding="12,8" Margin="8,0,0,0" FontSize="11" AutomationProperties.Name="恢复柔光默认快捷键"/>
       </Grid>
       <TextBlock x:Name="PowerShortcutState" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap"/>
       <TextBlock Text="开启 / 关闭智能跟随" FontSize="12"/>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="AutomaticShortcutBox" Tag="automatic" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" Padding="12,9" FontSize="13" Background="{DynamicResource GlassCard}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource SelectedStroke}" GotKeyboardFocus="ShortcutFocus" LostKeyboardFocus="ShortcutBlur" PreviewKeyDown="ShortcutKey" AutomationProperties.Name="智能跟随快捷键"/>
        <Button Grid.Column="1" Content="恢复默认" Tag="automatic" Click="ResetShortcut" Padding="12,8" Margin="8,0,0,0" FontSize="11" AutomationProperties.Name="恢复智能跟随默认快捷键"/>
       </Grid>
       <TextBlock x:Name="AutomaticShortcutState" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
       <TextBlock x:Name="ShortcutFeedback" Text="柔光默认 Ctrl + Alt + S；智能跟随默认 Ctrl + Alt + A。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="点击镜片开关柔光 · 滚轮微调 · Shift 加速" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="托盘单击快捷调整；双击打开完整工作台，右键可退出。" Margin="0,10,0,0" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Background="#40C3DCCC" CornerRadius="14" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="轻量，也尊重隐私。" FontSize="14"/><TextBlock Text="屏幕明暗只在本机采样，不保存截图，不上传内容。&#10;柔光覆盖所有已连接显示器，鼠标操作正常穿透。&#10;退出即恢复原样，不修改显示器的硬件亮度。" TextWrapping="Wrap" LineHeight="21" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
      <Button Content="退出 ScreenGlass" HorizontalAlignment="Left" Margin="0,20,0,0" Background="#65FFFFFF" Click="ExitClick"/><TextBlock x:Name="SettingsStatus" Margin="0,14,0,8" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>

