<Window x:Class="ScreenGlass.QuickPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:visuals="clr-namespace:ScreenGlass.Controls"
 Title="ScreenGlass · 快捷柔光" Width="308" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" UseLayoutRounding="True">
 <Border CornerRadius="8" BorderBrush="#B8FFFFFF" BorderThickness="1" Background="{DynamicResource GlassSurface}">
  <ScrollViewer x:Name="QuickScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14" Focusable="False">
   <StackPanel>
    <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ScreenGlass" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="SkinCaption" Text=" / 翡翠" FontSize="8" Foreground="#847853" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SoundButton" Click="SoundClick" MouseRightButtonUp="PreviewSoundClick" Width="28" Height="26" Padding="0" Background="Transparent" BorderThickness="0"><Grid Width="16" Height="16"><Path Data="M 1,6 L 4,6 8,3 8,13 4,10 1,10 Z" Fill="{DynamicResource Ink}"/><Path x:Name="SoundWaves" Data="M 10,5 Q 14,8 10,11 M 12,2 Q 18,8 12,14" Stroke="{DynamicResource Ink}" StrokeThickness="1.1"/><Path x:Name="MuteLine" Data="M 11,6 L 15,10 M 15,6 L 11,10" Stroke="{DynamicResource Ink}" StrokeThickness="1.2" Visibility="Collapsed"/></Grid></Button><Button Content="×" Width="26" Height="26" Padding="0" FontSize="17" Background="Transparent" BorderThickness="0" Click="DismissClick" ToolTip="收起 · Esc" AutomationProperties.Name="收起快捷面板"/></StackPanel></Grid>
    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="LensButton" Click="PowerClick" PreviewMouseWheel="LensWheel" Style="{StaticResource LensButton}" ToolTip="点击镜片开关柔光；滚轮微调强度，Shift 加速" AutomationProperties.Name="太阳镜柔光开关" AutomationProperties.HelpText="点击切换柔光；滚轮调整强度"><visuals:JewelSunglasses SkinId="{DynamicResource ActiveSkinId}" Width="164" Height="86" HorizontalAlignment="Left" Strength="{Binding Value, ElementName=StrengthControl}" IsLightEnabled="{Binding IsChecked, ElementName=PowerSwitch}"/></Button>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><ToggleButton x:Name="PowerSwitch" Click="PowerClick" AutomationProperties.Name="开启柔光" HorizontalAlignment="Right"/><TextBlock x:Name="PowerStatus" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Right"/></StackPanel>
    </Grid>
    <Grid Margin="0,2,0,0"><TextBlock x:Name="ModeHint" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="StrengthValue" HorizontalAlignment="Right" FontSize="24" FontFamily="Georgia"/></Grid>
    <Slider x:Name="StrengthControl" Minimum="5" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="StrengthChanged" PreviewMouseWheel="LensWheel" Margin="0,4,0,0" SmallChange="1" LargeChange="5" AutomationProperties.Name="快捷柔光强度"/>
    <visuals:DisplayPanel x:Name="DisplayControls" Margin="0,8,0,4"/>
    <UniformGrid Columns="3" Margin="0,9,0,0"><Button x:Name="Daily" Content="☼ 日常" Tag="daily" Click="PresetClick" Padding="3,8" FontSize="11" Margin="0,0,5,0"/><Button x:Name="Read" Content="▤ 阅读" Tag="read" Click="PresetClick" Padding="3,8" FontSize="11" Margin="0,0,5,0"/><Button x:Name="Night" Content="☾ 深夜" Tag="night" Click="PresetClick" Padding="3,8" FontSize="11"/></UniformGrid>
    <Border Height="1" Background="#3872897B" Margin="0,13,0,11"/>
    <Grid><TextBlock Text="智能跟随" FontSize="11" VerticalAlignment="Center"/><ToggleButton x:Name="AutoSwitch" HorizontalAlignment="Right" Click="AutoClick" AutomationProperties.Name="快捷智能跟随" ToolTip="跟随屏幕明暗；强度为柔光上限"/></Grid>
    <Grid Margin="0,9,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="低敏模式" FontSize="11"/><TextBlock Text=" · 减少波动" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></StackPanel><ToggleButton x:Name="LowSwitch" HorizontalAlignment="Right" Click="LowClick" AutomationProperties.Name="快捷低敏模式" ToolTip="配合智能跟随，持续明亮才开启柔光"/></Grid>
    <Grid Margin="0,13,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="JadeSkin" Tag="jade" Click="SkinClick" ToolTip="翡翠" AutomationProperties.Name="翡翠皮肤" Width="25" Height="25" Padding="4" Margin="0,0,4,0"><Ellipse Fill="#328F73" Width="13" Height="13"/></Button><Button x:Name="SapphireSkin" Tag="sapphire" Click="SkinClick" ToolTip="蓝宝石" AutomationProperties.Name="蓝宝石皮肤" Width="25" Height="25" Padding="4" Margin="0,0,4,0"><Ellipse Fill="#427AA8" Width="13" Height="13"/></Button><Button x:Name="RoseSkin" Tag="rose" Click="SkinClick" ToolTip="玫瑰碧玺" AutomationProperties.Name="玫瑰碧玺皮肤" Width="25" Height="25" Padding="4" Margin="0,0,4,0"><Ellipse Fill="#B9688B" Width="13" Height="13"/></Button><Button x:Name="AmberSkin" Tag="amber" Click="SkinClick" ToolTip="香槟琥珀" AutomationProperties.Name="香槟琥珀皮肤" Width="25" Height="25" Padding="4"><Ellipse Fill="#B88843" Width="13" Height="13"/></Button></StackPanel><Button Content="工作台 ↗" HorizontalAlignment="Right" FontSize="10" Padding="6,6" Background="Transparent" BorderThickness="0" Click="OpenClick"/></Grid>
   </StackPanel>
  </ScrollViewer>
 </Border>
</Window>
