<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ScreenGlass</AssemblyName>
    <Version>0.8.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\ScreenGlass.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);outputs/**;work/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\ScreenGlass.ico" /><Resource Include="Assets\Sounds\*.wav" /></ItemGroup>
</Project>
